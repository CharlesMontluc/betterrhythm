# Copy this file to .env and fill in the real values. Never commit .env.

# n8n encryption key: must be the key already stored in the n8n_data volume,
# otherwise saved credentials cannot be decrypted. See README, step 2.
N8N_ENCRYPTION_KEY=replace-with-your-key

# Public HTTPS address of the Cloudflare tunnel (changes on each tunnel restart)
WEBHOOK_URL=https://your-address.trycloudflare.com/

TZ=Europe/Paris

POSTGRES_USER=betterrhythm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=betterrhythm
